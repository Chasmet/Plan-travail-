<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lexique des spécificités"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ajoute ici les particularités à retenir pour les rues, secteurs ou tournées. Touche une note pour la modifier. Un appui long permet de la supprimer."
        android:textColor="#CCCCCC"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnAddLexique"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ajouter" />

        <Button
            android:id="@+id/btnDeleteLexique"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Supprimer" />
    </LinearLayout>

    <EditText android:id="@+id/searchLexique" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Rechercher dans le lexique" android:inputType="text" android:singleLine="true" android:textColor="@color/white" android:textColorHint="#AAAAAA" />

    <ListView
        android:id="@+id/listLexique"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:choiceMode="singleChoice"
        android:divider="#444444"
        android:dividerHeight="1dp" />

</LinearLayout>
