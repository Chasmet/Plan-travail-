<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lexique des spécificités"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ajoute ici les particularités à retenir pour les rues, secteurs ou tournées. Appui long sur une entrée pour la supprimer."
        android:textColor="#CCCCCC"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnAddLexique"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ajouter une spécificité" />

    <ListView
        android:id="@+id/listLexique"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:divider="#444444"
        android:dividerHeight="1dp" />

</LinearLayout>
