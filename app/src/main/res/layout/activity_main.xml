<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/black">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@color/surface_dark">
<TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plan Travail Orsay" android:textColor="@color/white" android:textStyle="bold" android:textSize="20sp"/>
<TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Chargement…" android:textColor="#CCCCCC" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><EditText android:id="@+id/etStreetSearch" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="Rechercher une rue" android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/white" android:textColorHint="#AAAAAA" android:background="#333333"/><Button android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="6dp" android:text="Chercher"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><Button android:id="@+id/btnMyLocation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ma position"/><Button android:id="@+id/btnToday" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Aujourd'hui"/><Button android:id="@+id/btnRemaining" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="À faire"/></LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btnRefresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rues"/><com.chasmet.plantravail.HighResExportButton android:id="@+id/btnExport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Export HD"/><Button android:id="@+id/btnDeleteTrace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Supprimer tracé"/><Button android:id="@+id/btnLexique" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Lexique"/><Button android:id="@+id/btnSync" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Sync MCP"/><Button android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Semaine"/><Button android:id="@+id/btnSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Réglages"/></LinearLayout></HorizontalScrollView>
<TextView android:id="@+id/tvLegend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/white" android:textSize="12sp"/>
</LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="© OpenStreetMap contributors • Contour : geo.api.gouv.fr" android:textColor="#CCCCCC" android:textSize="10sp" android:padding="4dp"/><com.chasmet.plantravail.OrsayMapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>