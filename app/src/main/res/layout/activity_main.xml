<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111B2A">
    <LinearLayout android:id="@+id/mapHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Plan Travail Orsay" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <Button android:id="@+id/btnHistory" style="@style/MapButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Semaine"/>
            <Button android:id="@+id/btnOptions" style="@style/MapButton" android:layout_width="48dp" android:layout_height="48dp" android:text="⋮" android:textSize="26sp" android:contentDescription="Outils du plan"/>
        </LinearLayout>
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C6D5E5" android:textSize="12sp" android:text="Chargement du plan…"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:gravity="center_vertical">
            <AutoCompleteTextView android:id="@+id/etStreetSearch" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="Rechercher une rue…" android:completionThreshold="1" android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="12dp" android:paddingEnd="4dp" android:textColor="#FFFFFF" android:textColorHint="#B6C8DA" android:background="@android:color/transparent" android:textSize="16sp"/>
            <Button android:id="@+id/btnSearch" style="@style/MapButton" android:layout_width="56dp" android:layout_height="48dp" android:text="Voir"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.chasmet.plantravail.OrsayMapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:id="@+id/tvLegend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="8dp" android:padding="8dp" android:background="@drawable/panel_background" android:textColor="#FFFFFF" android:textSize="12sp"/>
        <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="top|end" android:layout_marginTop="48dp" android:layout_marginEnd="8dp" android:background="@drawable/panel_background">
            <Button android:id="@+id/btnZoomIn" style="@style/MapButton" android:layout_width="52dp" android:layout_height="48dp" android:text="+" android:textSize="24sp" android:contentDescription="Zoomer. Appui prolongé pour continuer"/>
            <Button android:id="@+id/btnZoomLevel" style="@style/MapButton" android:layout_width="52dp" android:layout_height="48dp" android:text="14,7" android:textSize="12sp" android:contentDescription="Régler précisément le zoom"/>
            <Button android:id="@+id/btnZoomOut" style="@style/MapButton" android:layout_width="52dp" android:layout_height="48dp" android:text="−" android:textSize="24sp" android:contentDescription="Dézoomer. Appui prolongé pour continuer"/>
            <Button android:id="@+id/btnOverview" style="@style/MapButton" android:layout_width="52dp" android:layout_height="48dp" android:text="Orsay" android:textSize="11sp" android:contentDescription="Vue d’ensemble d’Orsay"/>
            <ImageButton android:id="@+id/btnFullscreen" android:layout_width="52dp" android:layout_height="48dp" android:src="@drawable/ic_fullscreen" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Agrandir le plan"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="bottom" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="52dp">
            <LinearLayout android:id="@+id/selectionPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone" android:background="@drawable/panel_background">
                <TextView android:id="@+id/selectedStreet" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
                    <Button android:id="@+id/btnProgress" style="@style/MapButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Avancement"/>
                    <Button android:id="@+id/btnStreetNote" style="@style/MapButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Note"/>
                    <Button android:id="@+id/btnCloseSelection" style="@style/MapButton" android:layout_width="48dp" android:layout_height="48dp" android:text="×" android:contentDescription="Fermer la fiche de rue"/>
                </LinearLayout>
            </LinearLayout>
            <com.chasmet.plantravail.ManualTraceControls android:id="@+id/manualTraceControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="6dp" android:background="@drawable/panel_background"/>
            <LinearLayout android:id="@+id/undoPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:visibility="gone" android:background="@drawable/panel_background">
                <TextView android:id="@+id/undoMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="10dp" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnUndo" style="@style/MapButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Annuler"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="3dp" android:text="© OpenStreetMap • Contour : geo.api.gouv.fr" android:textColor="#C6D5E5" android:textSize="10sp"/>
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="56dp" android:background="#162336">
        <Button android:id="@+id/btnPlan" style="@style/MapButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Plan" android:textColor="#93C5FD"/>
        <Button android:id="@+id/btnToday" style="@style/MapButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Journée"/>
        <Button android:id="@+id/btnLexique" style="@style/MapButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Lexique"/>
        <Button android:id="@+id/btnSettings" style="@style/MapButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Réglages"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="0dp"/>
        <com.chasmet.plantravail.HighResExportButton android:id="@+id/btnExport" android:layout_width="0dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btnDeleteTrace" android:layout_width="0dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btnSync" android:layout_width="0dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btnRemaining" android:layout_width="0dp" android:layout_height="0dp"/>
    </LinearLayout>
</LinearLayout>
