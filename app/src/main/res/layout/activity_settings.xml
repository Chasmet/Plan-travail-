<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Réglages" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/white" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAutoUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Vérifier automatiquement les mises à jour" android:textColor="@color/white" />
        <Button android:id="@+id/btnCheckUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Vérifier la mise à jour" />
        <ProgressBar android:id="@+id/progressUpdate" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="100" android:visibility="gone" />
        <TextView android:id="@+id/tvUpdateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#CCCCCC" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Serveur MCP intégré" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMcpServer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Activer automatiquement le serveur MCP" android:textColor="@color/white" />
        <TextView android:id="@+id/tvMcpServerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Serveur arrêté" android:textColor="#CCCCCC" />
        <Button android:id="@+id/btnMcpStartStop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Démarrer le serveur" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Adresse locale : http://127.0.0.1:8765/mcp" android:textColor="#AAAAAA" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Adresse publique MCP" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:id="@+id/tvMcpTunnelStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Préparation de l'adresse publique…" android:textColor="#AAAAAA" />
        <TextView android:id="@+id/tvPublicMcpUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:background="#222222" android:text="Création en cours…" android:textColor="#FFFFFF" android:textIsSelectable="true" />
        <Button android:id="@+id/btnCopyPublicMcpUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Copier l’URL pour ChatGPT" />
        <Button android:id="@+id/btnRestartPublicTunnel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Recréer l’adresse publique" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Colle cette adresse dans ChatGPT > URL du serveur > Aucune authentification. Aucun compte ni clé API n’est nécessaire." android:textColor="#AAAAAA" />

        <EditText android:id="@+id/etMcpUrl" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btnSave" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:text="Enregistrer" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Couleurs du jour : Lundi bleu · Mardi vert · Mercredi orange · Jeudi violet · Vendredi rouge · Samedi turquoise · Dimanche gris." android:textColor="#CCCCCC" />
    </LinearLayout>
</ScrollView>