<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Réglages" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/white" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAutoUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Vérifier automatiquement les mises à jour" android:textColor="@color/white" />
        <Button android:id="@+id/btnCheckUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Vérifier la mise à jour" />
        <ProgressBar android:id="@+id/progressUpdate" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="100" android:visibility="gone" />
        <TextView android:id="@+id/tvUpdateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#CCCCCC" />

        <Button android:id="@+id/btnResumeUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reprendre la mise à jour" />
        <Button android:id="@+id/btnCancelUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Annuler le téléchargement" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Synchronisation Android" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMcpServer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Synchroniser automatiquement à l’ouverture" android:textColor="@color/white" />
        <TextView android:id="@+id/tvMcpServerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Synchronisation arrêtée" android:textColor="#CCCCCC" />
        <Button android:id="@+id/btnMcpStartStop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Démarrer la synchronisation" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Adresse locale : http://127.0.0.1:8765/mcp" android:textColor="#AAAAAA" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Serveur MCP public Render" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:id="@+id/tvMcpTunnelStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Serveur HTTPS Render permanent" android:textColor="#AAAAAA" />
        <TextView android:id="@+id/tvPublicMcpUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:background="#222222" android:textColor="#FFFFFF" android:textIsSelectable="true" />
        <Button android:id="@+id/btnCopyPublicMcpUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Copier l’URL pour ChatGPT" />
        <Button android:id="@+id/btnRestartPublicTunnel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tester le serveur public" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="À coller dans ChatGPT > URL du serveur > Aucune authentification. Cette adresse HTTPS est fixe et hébergée sur Render." android:textColor="#AAAAAA" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Remise à zéro" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Efface tous les traçages de la semaine en cours et remet les compteurs à zéro. Le lexique est conservé." android:textColor="#AAAAAA" />
        <Button android:id="@+id/btnResetWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="RESET SEMAINE À ZÉRO" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Sauvegarde complète" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvBackupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" />
        <Button android:id="@+id/btnBackupExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exporter rues et lexique" />
        <Button android:id="@+id/btnBackupImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restaurer une sauvegarde" />
        <Button android:id="@+id/btnRestorePrevious" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revenir avant la dernière restauration" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Couleurs du jour : Lundi bleu · Mardi vert · Mercredi orange · Jeudi violet · Vendredi rouge · Samedi turquoise · Dimanche gris." android:textColor="#CCCCCC" />
    </LinearLayout>
</ScrollView>
